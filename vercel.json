{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/partner",
      "destination": "/partner.html"
    },
    {
      "source": "/s/:token",
      "destination": "/s/index.html"
    },
    {
      "source": "/partner/directory",
      "destination": "/directory.html"
    }
  ]
}